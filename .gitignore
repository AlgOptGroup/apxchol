# Build outputs (any dir starting with "build", e.g. build/, build64/, build-cuda/)
build*/
cmake-build-*/
benchmarks/build*/
CMakeFiles/
compile_commands.json

# IDE / editor
.idea/
.vscode/

# Data & results (download/generate locally)
data/
# Generated cell stores and plot previews stay local. The retired laptop store
# is preserved under benchmarks/archive/laptop-20260908/cells/. Current Daint
# extracts and their source/protocol metadata are committed under benchmarks/daint/.
results/*
benchmarks/results/
scripts/baselines/

# Machine-local paths to out-of-tree tools (benchmark runners / benchmark CMake)
benchmarks/paths_local.py
benchmarks/paths_local.cmake
# Julia Manifest pins absolute paths of local checkouts -- Project.toml is the
# portable source of truth; regenerate with Pkg.instantiate().
benchmarks/julia/Manifest.toml

# OS files
.DS_Store
Thumbs.db

# Compiled objects
*.o
*.a
*.so
*.dylib
*.mex
*.mexa64

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Editor backups
*~
*.swp
*.swo

# Tool state (matches both the .codex file and a .codex/ directory)
.codex

# Local tool state (worktrees, session state)
.claude/
benchmarks/cmg/octave-workspace
