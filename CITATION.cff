    given-names: Yves
    affiliation: "ETH Zürich"
  - family-names: Kyng
    given-names: Rasmus
    affiliation: "ETH Zürich"
repository-code: "https://github.com/AlgOptGroup/apxchol"
version: "0.2.1"
license: BSD-4-Clause
date-released: "2026-07-27"
keywords:
  - Laplacian solver
  - SDDM
  - approximate Cholesky
  - preconditioner
  - conjugate gradient
  - sparse linear algebra
