+# Sum represented Float64 entries with Neumaier compensation. Ordinary global
+# reduction crossed -1e-9 on large permuted grids although exact sums were
+# positive (diagnostic4616696). Preserve the producer thresholds and all rows.
+# Do not add @fastmath/SIMD reassociation to these error-recovery expressions.
+function apx_compensated_global_sum(G)
+    total = 0.0
+    correction = 0.0
+    for value in nonzeros(G)
+        updated = total + value
+        if abs(total) >= abs(value)
+            correction += (total - updated) + value
+        else
+            correction += (value - updated) + total
+        end
+        total = updated
+    end
+    result = total + correction
+    isfinite(result) || error("nonfinite compensated global matrix sum")
+    result
+end
