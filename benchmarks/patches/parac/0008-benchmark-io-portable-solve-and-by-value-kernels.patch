diff --git a/experiment/portable_pcg.hpp b/experiment/portable_pcg.hpp
new file mode 100644
index 0000000..e8b378e
--- /dev/null
+++ b/experiment/portable_pcg.hpp
@@ -0,0 +1,382 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <limits>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace apxchol::parac_portable {
+
+// Non-owning view of the arrays ParAC already materializes for MKL.  Despite
+// the upstream sparse_matrix member names (col_ptrs/row_indices), both A and U
+// are passed to MKL as CSR, and U is stored explicitly as a unit upper factor.
+template <class Index, class Scalar> struct csr_view {
+  std::size_t rows = 0;
+  std::span<const Index> row_offsets;
+  std::span<const Index> column_indices;
+  std::span<const Scalar> values;
+};
+
+struct pcg_result {
+  std::vector<double> x;
+  int iterations = 0;
+  // sqrt(r^T M^-1 r): the quantity oneMKL RCI exposes through sqrt(dpar[4])
+  // when preconditioning is enabled, and therefore the quantity upstream
+  // ParAC prints and checks.
+  double recurrence_residual_norm = 0.0;
+  bool reached_tolerance = false;
+};
+
+struct pcg_status {
+  int iterations = 0;
+  // See pcg_result::recurrence_residual_norm.
+  double recurrence_residual_norm = 0.0;
+  bool reached_tolerance = false;
+};
+
+namespace detail {
+
+template <class Index> std::size_t checked_size(Index value, const char *what) {
+  static_assert(std::is_integral_v<Index>, "CSR indices must be integral");
+  if constexpr (std::is_signed_v<Index>) {
+    if (value < 0)
+      throw std::invalid_argument(std::string(what) + " is negative");
+  }
+  using unsigned_index = std::make_unsigned_t<Index>;
+  const auto unsigned_value = static_cast<unsigned_index>(value);
+  if constexpr (sizeof(unsigned_index) > sizeof(std::size_t)) {
+    if (unsigned_value > std::numeric_limits<std::size_t>::max())
+      throw std::invalid_argument(std::string(what) + " does not fit size_t");
+  }
+  return static_cast<std::size_t>(unsigned_value);
+}
+
+template <class Index, class Scalar>
+void validate_csr(const csr_view<Index, Scalar> &matrix, const char *name) {
+  static_assert(std::is_floating_point_v<Scalar>,
+                "ParAC portable CSR values must be floating point");
+  if (matrix.row_offsets.size() != matrix.rows + 1)
+    throw std::invalid_argument(std::string(name) +
+                                " row-offset length is not n+1");
+  if (matrix.column_indices.size() != matrix.values.size())
+    throw std::invalid_argument(std::string(name) +
+                                " column/value lengths differ");
+  if (matrix.row_offsets.empty() ||
+      checked_size(matrix.row_offsets.front(), name) != 0)
+    throw std::invalid_argument(std::string(name) +
+                                " first row offset is not zero");
+
+  std::size_t previous = 0;
+  for (std::size_t row = 0; row < matrix.rows; ++row) {
+    const std::size_t begin = checked_size(matrix.row_offsets[row], name);
+    const std::size_t end = checked_size(matrix.row_offsets[row + 1], name);
+    if (begin != previous || end < begin || end > matrix.values.size())
+      throw std::invalid_argument(std::string(name) +
+                                  " has invalid row offsets");
+    for (std::size_t entry = begin; entry < end; ++entry) {
+      if (checked_size(matrix.column_indices[entry], name) >= matrix.rows)
+        throw std::invalid_argument(std::string(name) +
+                                    " column index is out of range");
+      if (!std::isfinite(static_cast<double>(matrix.values[entry])))
+        throw std::invalid_argument(std::string(name) +
+                                    " contains a non-finite value");
+    }
+    previous = end;
+  }
+  if (previous != matrix.values.size())
+    throw std::invalid_argument(std::string(name) +
+                                " final row offset does not equal nnz");
+}
+
+template <class Index, class Scalar>
+void validate_unit_upper(const csr_view<Index, Scalar> &upper) {
+  validate_csr(upper, "ParAC U");
+  for (std::size_t row = 0; row < upper.rows; ++row) {
+    const std::size_t begin = checked_size(upper.row_offsets[row], "ParAC U");
+    const std::size_t end = checked_size(upper.row_offsets[row + 1], "ParAC U");
+    bool found_diagonal = false;
+    std::size_t previous_column = 0;
+    bool first = true;
+    for (std::size_t entry = begin; entry < end; ++entry) {
+      const std::size_t column =
+          checked_size(upper.column_indices[entry], "ParAC U");
+      if (column < row)
+        throw std::invalid_argument("ParAC U contains a lower entry");
+      if (!first && column <= previous_column)
+        throw std::invalid_argument(
+            "ParAC U columns are not strictly increasing");
+      first = false;
+      previous_column = column;
+      if (column == row) {
+        if (static_cast<double>(upper.values[entry]) != 1.0)
+          throw std::invalid_argument("ParAC U diagonal is not exactly one");
+        found_diagonal = true;
+      }
+    }
+    if (!found_diagonal)
+      throw std::invalid_argument("ParAC U row is missing its unit diagonal");
+  }
+}
+
+template <class Scalar>
+void validate_diagonal(std::span<const Scalar> diagonal, std::size_t rows) {
+  if (diagonal.size() != rows)
+    throw std::invalid_argument("ParAC D length differs from n");
+  for (const Scalar entry : diagonal) {
+    if (!std::isfinite(static_cast<double>(entry)))
+      throw std::invalid_argument("ParAC D contains a non-finite value");
+  }
+}
+
+inline double dot(std::span<const double> lhs, std::span<const double> rhs) {
+  double sum = 0.0;
+  for (std::size_t i = 0; i < lhs.size(); ++i)
+    sum += lhs[i] * rhs[i];
+  return sum;
+}
+
+template <class Index, class Scalar>
+void csr_spmv_unchecked(const csr_view<Index, Scalar> &matrix,
+                        std::span<const double> x, std::span<double> result) {
+  for (std::size_t row = 0; row < matrix.rows; ++row) {
+    const std::size_t begin = static_cast<std::size_t>(matrix.row_offsets[row]);
+    const std::size_t end =
+        static_cast<std::size_t>(matrix.row_offsets[row + 1]);
+    double sum = 0.0;
+    for (std::size_t entry = begin; entry < end; ++entry) {
+      const std::size_t column =
+          static_cast<std::size_t>(matrix.column_indices[entry]);
+      sum += static_cast<double>(matrix.values[entry]) * x[column];
+    }
+    result[row] = sum;
+  }
+}
+
+template <class Index, class Scalar>
+void apply_preconditioner_unchecked(const csr_view<Index, Scalar> &upper,
+                                    std::span<const Scalar> diagonal,
+                                    std::span<const double> residual,
+                                    std::span<double> work,
+                                    std::span<double> result) {
+  // U^T y = r.  Scattering rows of CSR(U) visits every contribution to a
+  // destination in increasing source-row order.
+  std::copy(residual.begin(), residual.end(), work.begin());
+  for (std::size_t row = 0; row < upper.rows; ++row) {
+    const double solved = work[row]; // explicit diagonal is exactly one
+    const std::size_t begin = static_cast<std::size_t>(upper.row_offsets[row]);
+    const std::size_t end =
+        static_cast<std::size_t>(upper.row_offsets[row + 1]);
+    for (std::size_t entry = begin; entry < end; ++entry) {
+      const std::size_t column =
+          static_cast<std::size_t>(upper.column_indices[entry]);
+      if (column > row)
+        work[column] -= static_cast<double>(upper.values[entry]) * solved;
+    }
+  }
+
+  // Preserve upstream's singular-graph convention: a zero D entry is left
+  // unchanged rather than divided.  Nonzero entries follow y /= D exactly.
+  for (std::size_t row = 0; row < upper.rows; ++row) {
+    const double value = static_cast<double>(diagonal[row]);
+    if (value != 0.0)
+      work[row] /= value;
+  }
+
+  // U z = y.  Rows are independent once later unknowns have been solved.
+  for (std::size_t reverse = upper.rows; reverse > 0; --reverse) {
+    const std::size_t row = reverse - 1;
+    double solved = work[row];
+    const std::size_t begin = static_cast<std::size_t>(upper.row_offsets[row]);
+    const std::size_t end =
+        static_cast<std::size_t>(upper.row_offsets[row + 1]);
+    for (std::size_t entry = begin; entry < end; ++entry) {
+      const std::size_t column =
+          static_cast<std::size_t>(upper.column_indices[entry]);
+      if (column > row)
+        solved -= static_cast<double>(upper.values[entry]) * result[column];
+    }
+    result[row] = solved; // explicit diagonal is exactly one
+  }
+}
+
+} // namespace detail
+
+template <class Index, class Scalar>
+void csr_spmv(const csr_view<Index, Scalar> &matrix, std::span<const double> x,
+              std::span<double> result) {
+  detail::validate_csr(matrix, "ParAC A");
+  if (x.size() != matrix.rows || result.size() != matrix.rows)
+    throw std::invalid_argument("ParAC SpMV vector length differs from n");
+  detail::csr_spmv_unchecked(matrix, x, result);
+}
+
+template <class Index, class Scalar>
+void apply_preconditioner(
+    const csr_view<Index, Scalar> &upper,
+    std::span<const std::type_identity_t<Scalar>> diagonal,
+    std::span<const double> residual, std::span<double> work,
+    std::span<double> result) {
+  detail::validate_unit_upper(upper);
+  detail::validate_diagonal(diagonal, upper.rows);
+  if (diagonal.size() != upper.rows || residual.size() != upper.rows ||
+      work.size() != upper.rows || result.size() != upper.rows)
+    throw std::invalid_argument(
+        "ParAC preconditioner vector length differs from n");
+  detail::apply_preconditioner_unchecked(upper, diagonal, residual, work,
+                                         result);
+}
+
+// Prepared outside the measured solve interval, just like upstream's MKL path:
+// CSR handles/RCI vectors are created before its timer, while its initial A*x
+// request, the first preconditioner application, and every PCG iteration are
+// inside it.
+template <class Index, class Scalar> class pcg_solver {
+public:
+  pcg_solver(const csr_view<Index, Scalar> &matrix,
+             const csr_view<Index, Scalar> &upper,
+             std::span<const std::type_identity_t<Scalar>> diagonal,
+             std::span<const std::type_identity_t<Scalar>> rhs)
+      : matrix_(matrix), upper_(upper), diagonal_(diagonal), rhs_(matrix.rows),
+        x_(matrix.rows, 0.0), residual_(matrix.rows),
+        preconditioned_(matrix.rows), direction_(matrix.rows),
+        product_(matrix.rows), work_(matrix.rows) {
+    detail::validate_csr(matrix_, "ParAC A");
+    detail::validate_unit_upper(upper_);
+    detail::validate_diagonal(diagonal_, matrix_.rows);
+    if (matrix_.rows != upper_.rows || rhs.size() != matrix_.rows)
+      throw std::invalid_argument("ParAC portable PCG dimensions differ");
+    for (std::size_t i = 0; i < matrix_.rows; ++i)
+      rhs_[i] = static_cast<double>(rhs[i]);
+  }
+
+  // Explicit serial preconditioned CG translation of ParAC's MKL-RCI loop with
+  // patch 0007's original-system stopping. With preconditioning enabled,
+  // oneMKL RCI stores r^T M^-1 r in dpar[4]; patch 0007 compares its square
+  // root against `threshold` (= target * ||b||) and, when it passes, asks
+  // `check()` for the original residual. check() returns true to stop (the
+  // original target was met, the residual is non-finite, or the check budget
+  // is spent); otherwise the threshold tightens tenfold, exactly as patch 0007
+  // multiplies dpar[0] by 0.01, and iteration continues.
+  template <class Check>
+  pcg_status run(int max_iterations, double threshold, Check &&check) {
+    if (ran_)
+      throw std::logic_error("ParAC portable PCG workspace was reused");
+    ran_ = true;
+    if (max_iterations < 0)
+      throw std::invalid_argument("ParAC max_iterations is negative");
+    if (!std::isfinite(threshold) || threshold < 0.0)
+      throw std::invalid_argument(
+          "ParAC threshold is not finite and nonnegative");
+
+    pcg_status output;
+
+    // The first timed dcg() call requests A*x even though upstream's x is
+    // zero. Reproduce that request and form r=b-Ax before preconditioning;
+    // keeping it is part of matching the original solve-time boundary.
+    detail::csr_spmv_unchecked(matrix_, x_, product_);
+    for (std::size_t i = 0; i < matrix_.rows; ++i)
+      residual_[i] = rhs_[i] - product_[i];
+    detail::apply_preconditioner_unchecked(upper_, diagonal_, residual_, work_,
+                                           preconditioned_);
+    double rho = detail::dot(residual_, preconditioned_);
+    if (!std::isfinite(rho) || rho < 0.0)
+      throw std::runtime_error("ParAC portable PCG broke down at initial rTz");
+    output.recurrence_residual_norm = std::sqrt(rho);
+    if (max_iterations == 0)
+      return output;
+    if (rho == 0.0)
+      throw std::runtime_error("ParAC portable PCG broke down at initial rTz");
+    direction_ = preconditioned_;
+
+    while (output.iterations < max_iterations) {
+      detail::csr_spmv_unchecked(matrix_, direction_, product_);
+      const double denominator = detail::dot(direction_, product_);
+      if (!std::isfinite(denominator) || denominator == 0.0)
+        throw std::runtime_error("ParAC portable PCG broke down at pTAp");
+      const double alpha = rho / denominator;
+      if (!std::isfinite(alpha))
+        throw std::runtime_error(
+            "ParAC portable PCG produced a non-finite alpha");
+
+      for (std::size_t i = 0; i < matrix_.rows; ++i) {
+        x_[i] += alpha * direction_[i];
+        residual_[i] -= alpha * product_[i];
+      }
+      ++output.iterations;
+      // MKL requests preconditioning before its user stop request and
+      // updates dpar[4] to r^T M^-1 r. This includes the final converged
+      // or max-iteration step, so the triangular solves stay timed.
+      detail::apply_preconditioner_unchecked(upper_, diagonal_, residual_,
+                                             work_, preconditioned_);
+      const double next_rho = detail::dot(residual_, preconditioned_);
+      if (!std::isfinite(next_rho) || next_rho < 0.0)
+        throw std::runtime_error("ParAC portable PCG broke down at rTz");
+      output.recurrence_residual_norm = std::sqrt(next_rho);
+      if (output.recurrence_residual_norm <= threshold) {
+        output.reached_tolerance = true;
+        if (check(output.iterations))
+          break;
+        threshold *= 0.1;
+      }
+      if (output.iterations == max_iterations)
+        break;
+
+      if (!std::isfinite(rho) || rho == 0.0)
+        throw std::runtime_error("ParAC portable PCG broke down at rTz");
+      const double beta = next_rho / rho;
+      if (!std::isfinite(beta))
+        throw std::runtime_error(
+            "ParAC portable PCG produced a non-finite beta");
+      for (std::size_t i = 0; i < matrix_.rows; ++i)
+        direction_[i] = preconditioned_[i] + beta * direction_[i];
+      rho = next_rho;
+    }
+
+    return output;
+  }
+
+  const std::vector<double> &solution() const noexcept { return x_; }
+
+private:
+  csr_view<Index, Scalar> matrix_;
+  csr_view<Index, Scalar> upper_;
+  std::span<const Scalar> diagonal_;
+  std::vector<double> rhs_;
+  std::vector<double> x_;
+  std::vector<double> residual_;
+  std::vector<double> preconditioned_;
+  std::vector<double> direction_;
+  std::vector<double> product_;
+  std::vector<double> work_;
+  bool ran_ = false;
+};
+
+template <class Index, class Scalar>
+double
+true_relative_residual(const csr_view<Index, Scalar> &matrix,
+                       std::span<const double> x,
+                       std::span<const std::type_identity_t<Scalar>> rhs) {
+  detail::validate_csr(matrix, "ParAC A");
+  if (x.size() != matrix.rows || rhs.size() != matrix.rows)
+    throw std::invalid_argument("ParAC residual vector length differs from n");
+  std::vector<double> product(matrix.rows);
+  detail::csr_spmv_unchecked(matrix, x, product);
+  double residual_sq = 0.0;
+  double rhs_sq = 0.0;
+  for (std::size_t i = 0; i < matrix.rows; ++i) {
+    const double b = static_cast<double>(rhs[i]);
+    const double residual = product[i] - b;
+    residual_sq += residual * residual;
+    rhs_sq += b * b;
+  }
+  if (rhs_sq == 0.0)
+    return residual_sq == 0.0 ? 0.0 : std::numeric_limits<double>::infinity();
+  return std::sqrt(residual_sq / rhs_sq);
+}
+
+} // namespace apxchol::parac_portable
