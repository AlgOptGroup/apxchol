From: apxchol benchmark maintainers
Subject: [PATCH 8] Benchmark explicit RHS, solution output, portable CPU solve
 and producer permutation records

Applies after 0001-0007. Nothing changes unless selected:
- CPU driver: APXCHOL_PARAC_MKL_RCI (upstream oneMKL RCI path) or
  APXCHOL_PARAC_PORTABLE_CPP (serial C++ CSR/PCG translation of that loop,
  restored from b4a61899 and given patch 0007's original-residual stopping).
- PARAC_RHS_FILE (read before main) replaces the generated RHS in the CPU and
  GPU solves; PARAC_XB_FILE receives x and b after the timed solve.
- PARAC_WRITE_PERM=1 makes graph/physics producers record the composite
  permutation and producer input beside their output.
- Physics GPU: two kernels took the device-pointer descriptor by reference,
  i.e. through host memory. That works only where the GPU can address pageable
  host memory (HMM, GH200) and faults on RTX 4090 nodes without HMM (illegal
  memory access). Pass it by value; same reads.
---
diff --git a/cpu_implementation/apx_io.hpp b/cpu_implementation/apx_io.hpp
new file mode 100644
index 0000000..22e385a
--- /dev/null
+++ b/cpu_implementation/apx_io.hpp
@@ -0,0 +1,68 @@
+#pragma once
+// Benchmark-only input/output, enabled by environment variables and never timed.
+//   PARAC_RHS_FILE  (int64 n, double b[n]) in the order the driver solves (after
+//                   its permutation and any trim). Read during static
+//                   initialization, before every timer; the solve copies it
+//                   where it would otherwise generate its own RHS.
+//   PARAC_XB_FILE   receives (int64 n, double x[n], double b[n]) after the timed
+//                   solve, for grading outside the driver.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace apx_io {
+
+[[noreturn]] inline void fail(const char *what, const char *path) {
+    std::fprintf(stderr, "APX io error: %s: %s\n", what, path ? path : "");
+    std::exit(3);
+}
+
+inline const std::vector<double> &explicit_rhs() {
+    static const std::vector<double> rhs = [] {
+        std::vector<double> values;
+        const char *path = std::getenv("PARAC_RHS_FILE");
+        if (!path || !*path) return values;
+        std::FILE *file = std::fopen(path, "rb");
+        if (!file) fail("cannot open RHS", path);
+        std::int64_t n = -1;
+        if (std::fread(&n, sizeof n, 1, file) != 1 || n < 1) fail("bad RHS header", path);
+        values.resize(static_cast<std::size_t>(n));
+        if (std::fread(values.data(), sizeof(double), values.size(), file) != values.size())
+            fail("truncated RHS", path);
+        char extra;
+        if (std::fread(&extra, 1, 1, file) != 0) fail("trailing RHS data", path);
+        std::fclose(file);
+        return values;
+    }();
+    return rhs;
+}
+
+// Load before main(), so no timed interval contains the file read.
+inline const bool preloaded = (explicit_rhs(), true);
+
+// Replace a generated RHS with the explicit one when configured.
+template <class T> bool fill_rhs(T *b, std::size_t n) {
+    const auto &rhs = explicit_rhs();
+    if (rhs.empty()) return false;
+    if (rhs.size() != n) fail("RHS length differs from the solved system", std::getenv("PARAC_RHS_FILE"));
+    for (std::size_t i = 0; i < n; ++i) b[i] = static_cast<T>(rhs[i]);
+    return true;
+}
+
+template <class T> void write_xb(const T *x, const T *b, std::size_t n) {
+    const char *path = std::getenv("PARAC_XB_FILE");
+    if (!path || !*path) return;
+    std::FILE *file = std::fopen(path, "wb");
+    if (!file) fail("cannot open x/b output", path);
+    const std::int64_t count = static_cast<std::int64_t>(n);
+    std::vector<double> buffer(n);
+    bool ok = std::fwrite(&count, sizeof count, 1, file) == 1;
+    for (const T *source : {x, b}) {
+        for (std::size_t i = 0; i < n; ++i) buffer[i] = static_cast<double>(source[i]);
+        ok = ok && std::fwrite(buffer.data(), sizeof(double), n, file) == n;
+    }
+    if (std::fclose(file) != 0 || !ok) fail("cannot write x/b output", path);
+}
+
+} // namespace apx_io
