@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if ("@APXCHOL_CORE_TYPE@" STREQUAL "STATIC_LIBRARY")
    find_dependency(libzip 1.12.1 CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
endif()
if (NOT @APXCHOL_BUNDLED_EIGEN@)
    find_dependency(Eigen3 3.3 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/apxchol_openmp.cmake")
find_dependency(OpenMP COMPONENTS CXX)
apxchol_openmp_runtime(consumer_openmp_runtime)
if (NOT consumer_openmp_runtime STREQUAL "@APXCHOL_OPENMP_RUNTIME@")
    set(apxchol_FOUND FALSE)
    set(apxchol_NOT_FOUND_MESSAGE "This apxchol library uses OpenMP @APXCHOL_OPENMP_RUNTIME@, but this compiler found ${consumer_openmp_runtime}. Select the same OpenMP runtime with OpenMP_CXX_FLAGS, OpenMP_CXX_LIB_NAMES and OpenMP_<name>_LIBRARY, or rebuild apxchol with this compiler.")
    return()
endif()
if ("@APXCHOL_DEVICE@" STREQUAL "CUDA")
    find_dependency(CUDAToolkit 13.3)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/apxcholTargets.cmake")
check_required_components(apxchol)
