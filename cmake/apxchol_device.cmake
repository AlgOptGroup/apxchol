if (DEFINED APXCHOL_USE_CUDA OR DEFINED APXCHOL_USE_METAL)
    message(FATAL_ERROR "Use APXCHOL_DEVICE=CPU|CUDA|METAL instead of APXCHOL_USE_CUDA/APXCHOL_USE_METAL; remove the old entries from your CMake cache")
endif()

set(APXCHOL_DEVICE CPU CACHE STRING "Device backend: CPU, CUDA or METAL")
set_property(CACHE APXCHOL_DEVICE PROPERTY STRINGS CPU CUDA METAL)
if (NOT APXCHOL_DEVICE MATCHES "^(CPU|CUDA|METAL)$")
    message(FATAL_ERROR "APXCHOL_DEVICE must be CPU, CUDA or METAL")
endif()
if (APXCHOL_DEVICE STREQUAL "METAL" AND NOT APPLE)
    message(FATAL_ERROR "APXCHOL_DEVICE=METAL requires macOS")
endif()
