include_guard(GLOBAL)
if (NOT SKBUILD)
    find_package(libzip 1.12.1 CONFIG QUIET)
endif()
if (NOT libzip_FOUND)
    include(FetchContent)
    enable_language(C)
    function(apxchol_fetch_libzip)
        set(BUILD_SHARED_LIBS OFF)
        set(CMAKE_POSITION_INDEPENDENT_CODE ON)
        foreach(option COMMONCRYPTO GNUTLS OPENSSL WINDOWS_CRYPTO BZIP2 LZMA ZSTD)
            set(ENABLE_${option} OFF)
        endforeach()
        foreach(part TOOLS REGRESS OSSFUZZ EXAMPLES DOC)
            set(BUILD_${part} OFF)
        endforeach()
        if (SKBUILD)
            set(LIBZIP_DO_INSTALL OFF)
        endif()
        FetchContent_Declare(apxchol_libzip
            URL https://libzip.org/download/libzip-1.12.1.tar.xz
            URL_HASH SHA256=c40062022a1963c80573d48f6070792297cecd7c6bffe3aefcac0d8b9bee8913)
        FetchContent_MakeAvailable(apxchol_libzip)
        if (SKBUILD)
            install(FILES "${apxchol_libzip_SOURCE_DIR}/LICENSE"
                DESTINATION "${SKBUILD_METADATA_DIR}/licenses/libzip")
        else()
            install(FILES "${apxchol_libzip_SOURCE_DIR}/LICENSE"
                DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/apxchol/libzip")
        endif()
    endfunction()
    apxchol_fetch_libzip()
endif()
